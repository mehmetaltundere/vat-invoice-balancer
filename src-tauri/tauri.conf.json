{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EFA",
  "version": "0.1.0",
  "identifier": "com.exlora.efa",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "EFA - EXlora Fatura Asistanı",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mehmetaltundere/vat-invoice-balancer/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
